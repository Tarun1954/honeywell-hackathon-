# Copy this file to .env and fill in only the values used by your selected setup.
# Never commit real credentials. Relative paths resolve from the repository root.

# Phase 1 / EnergyPlus
ENERGYPLUS_HOME=.tools/EnergyPlus-26.1.0

# Phase 2 / local Ollama selection
# Example values: PHASE2_LLM_PROVIDER=ollama, PHASE2_LLM_MODEL=llama3.2:3b
# OLLAMA_BASE_URL is optional; the provider defaults to http://127.0.0.1:11434.
PHASE2_LLM_PROVIDER=
PHASE2_LLM_MODEL=
GROQ_API_KEY=
OLLAMA_BASE_URL=
